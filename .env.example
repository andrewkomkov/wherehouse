# Trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# LLM
ANTHROPIC_API_KEY=

# Frontend
VITE_TRIGGER_PUBLIC_ACCESS_TOKEN=
