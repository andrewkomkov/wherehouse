# ClickHouse Cloud (eu-west-1)
CLICKHOUSE_URL=https://<service-id>.eu-west-1.aws.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=geo

# The public read-only SQL user (ADR-003). readonly=1, GRANT SELECT ON web.* only.
CLICKHOUSE_SITE_USER=site
CLICKHOUSE_SITE_PASSWORD=

# Same user, exposed to the browser: the map fetches layers >256 KiB straight from
# ClickHouse (ADR-003 — CORS is open), so NEXT_PUBLIC_ ships these in the client bundle.
#
# The site password is a PUBLIC TOKEN by design — the same posture as play.clickhouse.com
# or a Mapbox public token — and it is safe because readonly=1 is not escapable from the
# client (verified: CREATE TABLE -> 497, setting override -> 164, system.users -> 497).
#
# It is STILL a credential. Real values live in .env, which is gitignored. This file is
# the committed contract and carries placeholders only.
NEXT_PUBLIC_CLICKHOUSE_URL=https://<service-id>.eu-west-1.aws.clickhouse.cloud:8443
NEXT_PUBLIC_CLICKHOUSE_SITE_USER=site
NEXT_PUBLIC_CLICKHOUSE_SITE_PASSWORD=

# ClickHouse Cloud API key (org-level API, not SQL auth)
CLICKHOUSE_API_KEY_ID=
CLICKHOUSE_API_KEY_SECRET=

# ClickHouse-managed Postgres (OLTP side, CDC'd into ClickHouse via ClickPipes)
# MUST be quoted — the & breaks `source .env` and silently drops every line below it.
# sslmode=require alone FAILS (Ubicloud cert); fetch the CA:
#   GET /v1/organizations/{org}/postgres/{id}/caCertificates  → raw PEM, not JSON
POSTGRES_URL="postgres://postgres:<pw>@<host>.aws.pg.clickhouse.cloud:5432/postgres?sslmode=verify-full&sslrootcert=.secrets/pg-ca.crt"
POSTGRES_HOST=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Trigger.dev
# TRIGGER_SECRET_KEY is the DEV key (tr_dev_…), used by a local `pnpm exec trigger dev`.
# TRIGGER_SECRET_KEY_PROD (tr_prod_…) is what the deployed Cloudflare Worker uses, so the
# live site works with no local process running — fetched by `./infra/deploy-trigger.sh key`
# (GET /api/v1/projects/{ref}/prod, needs the trigger CLI logged in), not typed in by hand.
TRIGGER_SECRET_KEY=
TRIGGER_SECRET_KEY_PROD=
TRIGGER_PROJECT_ID=

# LLM — Trigger.dev provides none; bring your own key. Hackathon credits don't cover it.
# Works with real Anthropic, or any Anthropic-compatible endpoint (we use DeepSeek:
# baseURL https://api.deepseek.com/anthropic, model deepseek-v4-flash).
# Drop ANTHROPIC_BASE_URL to use Anthropic proper.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
LLM_MODEL=

# Frontend
VITE_TRIGGER_PUBLIC_ACCESS_TOKEN=

# Frontend -> Cloudflare Worker (day 5 / ADR-003 "for real") — infra/app-worker/
NEXT_PUBLIC_API_BASE_URL=
