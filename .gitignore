.env
.env.local
# raw credential drops — repo goes public at submission
*api-key*.txt
*credentials*.json
.secrets/
node_modules/
dist/
build/
.next/
# Next static export (`output: "export"`) — rebuildable with `pnpm --dir web build`,
# and it's what infra/deploy-app.sh loads into ClickHouse, not a source artifact.
out/
*.tsbuildinfo
next-env.d.ts
.turbo/
.trigger/
.wrangler/
*.log
.DS_Store
data/
*.pbf
# but DO track the vendored map glyphs — they're part of the self-contained bundle
# (served out of ClickHouse), not a rebuildable OSM extract.
!web/public/basemaps-assets/**
*.pmtiles
# cut basemap extracts — rebuildable with ./infra/basemap.sh extract
.basemap/
*.parquet
.venv/
__pycache__/

# video pipeline — heavy build artifacts, not source
video/**/node_modules/
video/out/
video/remotion/out/
video/remotion/public/screen.mp4
video/remotion/public/console.mp4
video/remotion/public/narration.mp3
video/voiceover/out/
video/voiceover/.venv/
video/**/__pycache__/
